{
  "expo": {
    "name": "Baby Buddy",
    "slug": "baby-buddy-native",
    "version": "1.0.0-5",
    "orientation": "portrait",
    "icon": "./assets/play_store_icon_512.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mosherw.babybuddy"
    },
    "android": {
      "package": "com.babybuddy.dashboard",
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EF",
        "foregroundImage": "./assets/ic_launcher_foreground_432.png",
        "backgroundImage": "./assets/ic_launcher_background_432.png"
      },
      "splash": {
        "image": "./assets/splash_1080x2340.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ]
  }
}