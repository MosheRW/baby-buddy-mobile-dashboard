{
  "expo": {
    "name": "Baby Buddy",
    "slug": "baby-buddy-mobile-dashboard",
    "version": "2026.08.31-3",
    "orientation": "portrait",
    "icon": "./assets/play_store_icon_512.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mosherw.babybuddy"
    },
    "android": {
      "jsEngine": "hermes",
      "package": "com.mosherw.babybuddy",
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EF",
        "foregroundImage": "./assets/ic_launcher_foreground_432.png",
        "backgroundImage": "./assets/ic_launcher_background_432.png"
      },
      "splash": {
        "image": "./assets/splash_1080x2340.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Baby Buddy to use the camera to scan a sign-in QR code."
        }
      ]
    ]
  }
}